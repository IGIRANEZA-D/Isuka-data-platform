# Set these in Vercel for Production and Preview as indicated.
NODE_ENV=production

# Production and Preview: required for account features; use a TLS Atlas URI.
MONGODB_URI=
MONGODB_DATABASE=isuka
SESSION_SECRET=
PUBLIC_BASE_URL=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=15000
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=5
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_RECONNECT_COOLDOWN_MS=2000

# Production and Preview: sender must be verified by Resend for delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=isukaplatform@gmail.com

# Production: required to seed the first admin. Preview: optional, use test values.
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=
# Backward-compatible email seed credentials, if that is how the admin was created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production and Preview: uploads are disabled on Vercel; set false explicitly.
DATA_UPLOAD_ENABLED=false
TRUST_PROXY=1

# Production and Preview: optional assistant provider; blank keeps deterministic mode.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_DAILY_BUDGET=0

# Production and Preview: optional legacy provider credentials for farmer advice.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_URL=https://api.openai.com/v1/responses

# Production and Preview: optional weather-provider configuration.
METEOMATICS_USER=
METEOMATICS_PASSWORD=
METEOMATICS_API_URL=https://api.meteomatics.com
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Local development only. PORT is assigned by the host and is not required.
FRONTEND_ORIGIN=http://localhost:5173
ISUKA_DATASETS_DIR=
ISUKA_UPLOADS_DIR=
PYTHON=python
